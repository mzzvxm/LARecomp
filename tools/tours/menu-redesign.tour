#@title Check the graphics layout and the preset boundary on a clean Native RT-capable run
#@duration 75s
#@default GRAPHICS_DOWNS=5
#@default PRESET_STEPS=4
#@default DISPLAY_STEPS=8
#@default IMAGE_STEPS=2
#@default EFFECT_PAGES=3
# CHECK: Confirm the route with check_menu_redesign_tour.py after the first smoke run.
wait_until roam timeout=20s
press_until start paused every=2s timeout=12s
wait 1500ms
press rb 4f
wait 1200ms
press rb 4f
wait 1200ms
wait_until paused timeout=5s
@repeat {GRAPHICS_DOWNS}: press down 4f ; wait 400ms
press a 4f
wait 1500ms
shot graphics

# Select Enhanced RT Ultra, then open Display and change Post AA from Off to FXAA.
press down 4f
wait 600ms
@repeat {PRESET_STEPS}: press right 4f ; wait 700ms
shot enhanced-rt-ultra
press up 4f
wait 600ms
press a 4f
wait 1500ms
wait_until paused timeout=5s
@repeat {DISPLAY_STEPS}: press down 4f ; wait 400ms
shot display-post-aa
press right 4f
wait 900ms
shot display-post-aa-fxaa
press b 4f
wait 1500ms
shot graphics-after-display

# The named preset must still be applied. Change Texture Filtering to make it Custom.
@repeat {IMAGE_STEPS}: press down 4f ; wait 600ms
press a 4f
wait 1500ms
wait_until paused timeout=5s
shot image-quality
press right 4f
wait 900ms
press b 4f
wait 1500ms
shot graphics-custom

# Check that the remaining three pages can open in order.
@repeat {EFFECT_PAGES}: press down 4f ; wait 600ms ; press a 4f ; wait 1500ms ; wait_until paused timeout=5s ; shot effect-page-{I} ; press b 4f ; wait 1500ms
press b 4f
wait 1500ms
press_until start not paused every=2s timeout=12s
wait_until roam timeout=15s
