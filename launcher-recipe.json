{
  "schema": "larecomp.launcher-recipe",
  "schema_version": 1,
  "min_reader": 1,
  "min_launcher": "1.0.0",
  "sdk": {
    "commit": "b54e6ea5e87d2829e736b003ca72b53aada7de4f",
    "prebuilt": { "options": ["REXGLUE_ENABLE_TRACY=OFF"] }
  },
  "toolchain": { "cmake": ">=3.25", "clang": ">=20", "ninja": ">=1.11", "cxx": 23, "sdk": "0.11" },
  "presets": { "windows": "win-amd64-release", "linux": "linux-amd64-release" },
  "codegen": {
    "tool": "rexglue",
    "args": ["codegen", "larecomp_manifest.toml"],
    "inputs": ["default.xex"],
    "place": { "default.xex": "out/build/win-amd64-release/assets/default.xex" }
  },
  "options": [
    { "name": "LARECOMP_GPU", "value": "ON" },
    { "name": "LARECOMP_CPU_LEVEL", "from": "launcher.cpu_level" },
    { "name": "LARECOMP_DLSS_FETCH", "value": "OFF", "when": "os.name == 'windows' && gpu.vendor != 'nvidia'" },
    { "name": "LARECOMP_DXC_HOST_ARCHIVE", "from": "kit:dxc_host", "when": "os.name == 'windows'" }
  ],
  "targets": ["larecomp", "larecomp_online_tool"],
  "kits": "cmake/deps.json"
}
