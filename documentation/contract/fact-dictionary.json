{
  "schema": "larecomp.fact-dictionary",
  "schema_version": 1,
  "about": "Every machine fact a condition may read (LAUNCHER-FOLLOWS-GAME section 2.4) as data: the path, its type, the words an enum may take, whether the launcher has it before the first probe (l0), and the game function that decides it. A rule that names a path that is not here (and not under an open prefix) is a typo, and the exporter's lint 2 fails it. machine.json holds the same paths under the same names; a leaf of machine.json that is not here is allowed (additive) but the validator says so.",
  "types": ["bool", "int", "number", "string", "list"],
  "open_prefixes": ["install."],
  "not_readable": ["gpu.adapters", "display.list", "display.windowed_sizes", "display.exclusive_sizes", "paths"],
  "facts": {
    "gpu.name": { "type": "string", "l0": true, "source": "DXGI + Plume description (gpu/device.cpp)", "used_by": "Graphics Card row, support text" },
    "gpu.vendor": { "type": "string", "enum": ["nvidia", "amd", "intel", "apple", "qualcomm", "microsoft", "other"], "l0": true, "source": "the adapter's PCI vendor id", "used_by": "denoiser rows, vendor rows" },
    "gpu.vendor_id": { "type": "int", "l0": true, "source": "DXGI / Vulkan adapter description" },
    "gpu.device_id": { "type": "int", "l0": true, "source": "DXGI / Vulkan adapter description" },
    "gpu.vram_mb": { "type": "int", "l0": true, "source": "DXGI / Vulkan adapter description" },
