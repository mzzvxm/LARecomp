                {"id": "40", "label": "40"},
                {"id": "45", "label": "45"},
                {"id": "50", "label": "50"},
                {"id": "60", "label": "60"},
                {"id": "120", "label": "120"},
                {"id": "144", "label": "144"},
                {"id": "0", "label": "UNCAPPED", "title": "Unlimited"}
              ],
              "states": [
                {
                  "when": "d.frame_gen_on",
                  "enabled": false,
                  "suffix": " (FRAME GEN)",
                  "tag": "Frame gen on",
                  "reason": "Frame generation has its own limit (Frame Gen FPS Limit) while it runs, so this one waits."
                }
              ],
              "help": "Caps how many frames the game draws a second. Unlimited removes the cap."
