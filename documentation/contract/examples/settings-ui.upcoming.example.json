              "title": "DLSS Ray Reconstruction",
              "kind": "bool",
              "setting": "mcla_gpu_vendor_denoiser",
              "default": "false",
              "apply": "live",
              "renderers": ["native"],
              "hidden_unless": "renderer == 'native' && d.denoiser_vendor in ['amd','nvidia']",
              "states": [
