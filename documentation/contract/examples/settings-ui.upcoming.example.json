    "os.exclusive_fullscreen",
    "os.name"
  ],
  "presets": {
    "setting": "mcla_gpu_preset",
    "order": ["vanilla", "enhanced", "enhanced_ultra", "enhanced_rt", "enhanced_rt_ultra", "custom"],
    "first_start": "vanilla",
    "scope": ["lighting", "reflections"],
    "items": {
      "vanilla": {
        "label": "VANILLA",
        "title": "Vanilla",
        "help": "The game as it shipped: none of the new effects.",
        "needs": null,
        "values": {"mcla_gpu_shadow_resolution": "game", "mcla_gpu_rt_reflections": "off"}
      },
      "enhanced": {
        "label": "ENHANCED",
        "title": "Enhanced",
        "help": "Better shadows, no ray tracing.",
        "needs": null,
        "values": {"mcla_gpu_shadow_resolution": "high", "mcla_gpu_rt_reflections": "off"}
      },
      "enhanced_ultra": {
        "label": "ENHANCED ULTRA",
        "title": "Enhanced Ultra",
        "help": "The best shadows, no ray tracing.",
        "needs": null,
        "values": {"mcla_gpu_shadow_resolution": "ultra", "mcla_gpu_rt_reflections": "off"}
      },
      "enhanced_rt": {
        "label": "ENHANCED RT",
        "title": "Enhanced RT",
        "help": "Better shadows and ray traced reflections.",
        "needs": "gpu.rt_tier != 'none'",
        "needs_reason": "Needs a graphics card that can ray trace.",
        "values": {"mcla_gpu_shadow_resolution": "high", "mcla_gpu_rt_reflections": "high"}
      },
      "enhanced_rt_ultra": {
        "label": "ENHANCED RT ULTRA",
        "title": "Enhanced RT Ultra",
        "help": "The best shadows and ray traced reflections.",
        "needs": "gpu.rt_tier != 'none'",
        "needs_reason": "Needs a graphics card that can ray trace.",
        "values": {"mcla_gpu_shadow_resolution": "ultra", "mcla_gpu_rt_reflections": "ultra"}
      },
      "custom": {"label": "CUSTOM", "title": "Custom", "help": "Your own choices on the effect pages.", "needs": null}
    },
    "class_to_preset": [
      {"when": "gpu.class == 'high' && gpu.rt_tier == 'strong'", "preset": "enhanced_rt_ultra"},
      {"when": "gpu.class == 'high'", "preset": "enhanced_ultra"},
      {"when": "gpu.class == 'mid' && gpu.rt_tier != 'none'", "preset": "enhanced_rt"},
      {"when": "gpu.class == 'mid'", "preset": "enhanced"},
      {"when": "true", "preset": "vanilla"}
    ],
    "covers": ["mcla_gpu_rt_reflections", "mcla_gpu_shadow_resolution"],
    "flip": {"to": "custom", "writes": [{"setting": "mcla_gpu_preset_from", "value": "$previous"}]}
  }
