                  "label": "DLSS MODE",
                  "title": "DLSS Mode",
                  "setting": "mcla_gpu_dlss_mode",
                  "values_ref": "dlss_modes",
                  "states": [
                    {
                      "when": "features.upscalers.dlss == 'needs_setup'",
                      "enabled": false,
                      "suffix": " (SETUP)",
