              "id": "PM_RxDisplayMode",
              "label": "DISPLAY MODE",
              "title": "Display Mode",
              "kind": "choice",
              "setting": null,
              "reads": ["fullscreen", "fullscreen_exclusive"],
              "apply": "live",
              "decode": {
                "cases": [
                  {"when": "!s.fullscreen", "value": "windowed"},
                  {"when": "s.fullscreen_exclusive && os.exclusive_fullscreen", "value": "fullscreen"},
                  {"value": "borderless"}
                ]
              },
              "values": [
                {"id": "windowed", "label": "WINDOWED", "title": "Windowed", "writes": [{"setting": "fullscreen", "value": "false"}]},
                {
                  "id": "borderless",
                  "label": "BORDERLESS",
                  "title": "Borderless",
                  "writes": [{"setting": "fullscreen_exclusive", "value": "false"}, {"setting": "fullscreen", "value": "true"}]
                },
                {
                  "id": "fullscreen",
                  "label": "FULLSCREEN",
                  "title": "Fullscreen",
                  "when": "os.exclusive_fullscreen",
                  "writes": [{"setting": "fullscreen_exclusive", "value": "true"}, {"setting": "fullscreen", "value": "true"}]
                }
              ],
              "help": "Windowed is a normal window. Borderless fills the screen with a window that has no frame and leaves the display as it is. Fullscreen can also switch the display to the size chosen in Resolution."
            },
            {
              "id": "PM_RxFpsCap",
              "label": "FPS LIMIT",
              "title": "FPS Limit",
              "kind": "number",
              "setting": "fps_limit",
              "format": "%.0f",
              "apply": "live",
              "values": [
