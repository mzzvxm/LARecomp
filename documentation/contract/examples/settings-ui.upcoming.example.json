                { "when": "d.denoiser_state == 'needs_setup'", "enabled": false, "suffix": " (SETUP)", "label": "DLSS RR" },
                { "when": "d.denoiser_state == 'failed'", "enabled": false, "suffix": " (FAILED)", "label": "DLSS RR" },
                { "when": "d.denoiser_state == 'not_needed'", "enabled": false, "suffix": " (NOT NEEDED)", "label": "DLSS RR" },
                { "when": "d.denoiser_state == 'making'", "enabled": true, "suffix": " (APPLYING)", "label": "DLSS RR" },
                { "when": "d.denoiser_state == 'restart'", "enabled": true, "suffix": " (RESTART)", "label": "DLSS RR", "needs_restart": true }
