                { "when": "d.denoiser_state == 'needs_d3d12'", "enabled": false, "suffix": " (D3D12 ONLY)", "label": "DLSS RR" },
                { "when": "d.denoiser_state == 'unsupported'", "enabled": false, "suffix": " (N/A)", "label": "DLSS RR" },
