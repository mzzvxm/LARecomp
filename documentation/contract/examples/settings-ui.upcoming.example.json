                  "when": "s.perf_no_shadows",
                  "enabled": false,
                  "suffix": " (NO SHADOW)",
                  "tag": "Shadows off",
                  "reason": "Does nothing while Shadows are off. Your choice is kept."
                }
              ],
              "help": "How sharp the edges of the sun's shadows can get. High draws them twice as big and Ultra three times, which costs a little speed and video memory."
            }
          ]
        },
        {
          "id": "reflections",
          "label": "REFLECTIONS",
          "title": "Reflections",
          "source_menu": "RxReflectionsMenu",
          "renderers": ["native"],
          "rows": [
            {
              "id": "PM_RxGpuRtCityRefl",
              "label": "RT CITY REFLECTIONS",
              "title": "RT City Reflections",
              "kind": "choice",
              "setting": "mcla_gpu_rt_reflections",
              "renderers": ["native"],
              "values_ref": "rt_levels",
              "apply": "live",
              "states": [
                {
                  "when": "gpu.rt_tier == 'none'",
                  "label": "RT CITY",
                  "suffix": " (NO RT GPU)",
                  "enabled": false,
                  "tag": "No ray tracing card",
                  "reason": "Needs a graphics card that can ray trace."
                },
                {
                  "when": "gpu.class == 'low'",
                  "label": "RT CITY",
                  "suffix": " (TOO SLOW)",
                  "enabled": false,
                  "tag": "Too slow",
                  "reason": "This graphics card is too slow for ray traced reflections."
                },
                {
                  "when": "!d.car_rt_runs",
                  "label": "RT CITY",
                  "suffix": " (NEEDS CAR RT)",
                  "enabled": false,
                  "tag": "Needs ray traced car reflections",
                  "reason": "Set Car Self-Reflections to Ray Traced first: this rides on it."
                },
                {
                  "when": "d.rt_city_wanted && live.city_data == 'unavailable'",
                  "live_only": true,
                  "label": "RT CITY",
                  "suffix": " (NOT READY)",
                  "enabled": false,
                  "tag": "Not ready",
                  "reason": "The city's data cannot be had this session."
                },
                {
                  "when": "d.rt_city_wanted && live.city_data == 'building'",
                  "live_only": true,
                  "label": "RT CITY",
                  "suffix": " (BUILDING DATA)",
                  "tag": "Building city data",
                  "reason": "The game is building the city's data in the background. The setting is kept and takes hold by itself."
                }
              ],
              "help": "The car paint reflects the real street, found by rays in the city's own triangles: the building across the road, the lamp posts, signs, the car beside you."
            },
            {
              "id": "PM_RxGpuCarSelfRefl",
              "label": "CAR SELF-REFLECTIONS",
              "title": "Car Self-Reflections",
              "kind": "choice",
              "setting": null,
              "reads": ["mcla_gpu_car_selfrefl", "mcla_gpu_car_selfrefl_rt"],
              "renderers": ["native"],
              "apply": "live",
              "decode": "d.car_selfrefl_choice",
              "values": [
                {
                  "id": "auto",
                  "label": "AUTO",
                  "title": "Auto",
                  "auto_label": true,
                  "label_rules": [
                    {"when": "auto_of('mcla_gpu_car_selfrefl') != 'on'", "label": "AUTO (OFF)"},
                    {"when": "api.car_rt", "label": "AUTO (RAY TRACED)"},
                    {"when": "api.car_rt == false", "label": "AUTO (ON)"}
                  ],
                  "writes": [{"setting": "mcla_gpu_car_selfrefl", "value": "auto"}, {"setting": "mcla_gpu_car_selfrefl_rt", "value": "auto"}]
                },
                {"id": "off", "label": "OFF", "title": "Off", "writes": [{"setting": "mcla_gpu_car_selfrefl", "value": "off"}]},
                {
                  "id": "on",
                  "label": "ON",
                  "title": "On",
                  "writes": [{"setting": "mcla_gpu_car_selfrefl", "value": "on"}, {"setting": "mcla_gpu_car_selfrefl_rt", "value": "off"}]
                },
                {
                  "id": "ray_traced",
                  "label": "RAY TRACED",
                  "title": "Ray Traced",
                  "when": "api.car_rt",
                  "writes": [{"setting": "mcla_gpu_car_selfrefl", "value": "on"}, {"setting": "mcla_gpu_car_selfrefl_rt", "value": "auto"}]
                }
              ],
              "help": "Your car's paint reflects the car itself. On works from the picture on the screen; Ray Traced from the car's own shape, so a part the camera cannot see shows in the paint too."
            }
          ]
        }
      ]
    }
