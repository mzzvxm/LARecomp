                    { "when": "d.denoiser_state == 'unsupported'", "enabled": false, "suffix": " (N/A)", "label": "RAY REGEN" },
                    { "when": "d.denoiser_state == 'needs_dlss'", "enabled": false, "suffix": " (NEEDS DLSS)", "label": "RAY REGEN" },
                    { "when": "d.denoiser_state == 'needs_setup'", "enabled": false, "suffix": " (SETUP)", "label": "RAY REGEN" },
                    { "when": "d.denoiser_state == 'failed'", "enabled": false, "suffix": " (FAILED)", "label": "RAY REGEN" },
                    { "when": "d.denoiser_state == 'not_needed'", "enabled": false, "suffix": " (NOT NEEDED)", "label": "RAY REGEN" },
                    { "when": "d.denoiser_state == 'making'", "enabled": true, "suffix": " (APPLYING)", "label": "RAY REGEN" },
                    { "when": "d.denoiser_state == 'restart'", "enabled": true, "suffix": " (RESTART)", "label": "RAY REGEN", "needs_restart": true }
                  ]
                }
              ],
              "help": "On uses the GPU's denoiser for supported effects. Off uses LARecomp's denoisers."
