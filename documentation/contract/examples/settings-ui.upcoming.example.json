  "defs": {
    "frame_gen_on": "live.frame_generation_running ?? ((s.mcla_gpu_frame_generation == 'fsr31' && features.frame_generation.fsr31) || (s.mcla_gpu_frame_generation == 'dlss' && features.frame_generation.dlss))",
    "shown_upscaler": {
      "cases": [
        {"when": "s.mcla_gpu_upscaler == 'fsr31' && features.upscalers.fsr31", "value": "fsr31"},
        {"when": "s.mcla_gpu_upscaler == 'fsr4' && features.upscalers.fsr4", "value": "fsr4"},
        {"when": "s.mcla_gpu_upscaler == 'dlss' && features.upscalers.dlss != 'no'", "value": "dlss"},
        {"when": "s.mcla_gpu_fsr", "value": "fsr1"},
        {"value": "off"}
      ]
    },
    "car_selfrefl_choice": {
      "cases": [
        {"when": "s.mcla_gpu_car_selfrefl == 'off'", "value": "off"},
        {"when": "s.mcla_gpu_car_selfrefl == 'on' && (s.mcla_gpu_car_selfrefl_rt == 'off' || !api.car_rt)", "value": "on"},
        {"when": "s.mcla_gpu_car_selfrefl == 'on'", "value": "ray_traced"},
        {"when": "s.mcla_gpu_car_selfrefl_rt != 'off'", "value": "auto"},
        {"when": "auto_of('mcla_gpu_car_selfrefl') == 'on'", "value": "on"},
        {"value": "off"}
      ]
    },
    "car_rt_runs": "api.car_rt && (d.car_selfrefl_choice == 'ray_traced' || (d.car_selfrefl_choice == 'auto' && auto_of('mcla_gpu_car_selfrefl') == 'on'))",
    "rt_city_wanted": "resolved(s.mcla_gpu_rt_reflections) != 'off'",
    "denoiser_vendor": { "cases": [
      {"when": "features.denoiser.vendor == 'amd' && (gpu.rx9000 ?? true) && (os.name ?? 'windows') == 'windows' && ((os.build ?? 0) == 0 || os.build >= 22000)", "value": "amd"},
      {"when": "features.denoiser.vendor == 'nvidia' && (gpu.rtx ?? true)", "value": "nvidia"},
      {"when": "known(features.denoiser.vendor)", "value": "none"},
      {"when": "gpu.vendor == 'amd' && gpu.rx9000 && os.name == 'windows' && ((os.build ?? 0) == 0 || os.build >= 22000)", "value": "amd"},
      {"when": "gpu.vendor == 'nvidia' && gpu.rtx", "value": "nvidia"},
      {"value": "none"}
    ] },
    "denoiser_fallback": { "cases": [
      {"when": "d.denoiser_vendor == 'amd' && api.name == 'vulkan'", "value": "needs_d3d12"},
      {"when": "d.denoiser_vendor == 'amd' && features.denoiser.ray_regen == 'unsupported'", "value": "unsupported"},
      {"when": "d.denoiser_vendor == 'nvidia' && (features.upscalers.dlss == 'no' || features.denoiser.dlss_rr == 'unsupported')", "value": "unsupported"},
      {"when": "d.denoiser_vendor == 'nvidia' && s.mcla_gpu_upscaler != 'dlss'", "value": "needs_dlss"},
      {"when": "d.denoiser_vendor == 'nvidia' && (features.upscalers.dlss == 'needs_setup' || features.denoiser.dlss_rr == 'needs_setup')", "value": "needs_setup"},
      {"when": "d.denoiser_vendor == 'amd' && features.denoiser.ray_regen == 'needs_setup'", "value": "needs_setup"},
      {"when": "d.denoiser_vendor == 'nvidia' && s.mcla_gpu_vendor_denoiser && (features.upscalers.dlss == 'after_restart' || features.denoiser.dlss_rr == 'after_restart')", "value": "restart"},
      {"value": "ok"}
    ] },
    "denoiser_state": "live.denoiser_gate ?? d.denoiser_fallback"
  },
