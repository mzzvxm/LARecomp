# Selects the build-time compiler for src/gpu/hlsl. On Windows the launcher
# and CMake share the kit in deps.json; on Linux the shader pack builder and
# the host shaders use the same archive. Include after adding dxc-bin, which
# supplies dxcapi.h and the fallback compiler for offline builds.

set(LARECOMP_DXC_HOST_DIR "" CACHE PATH "An unpacked DXC release for the host shaders")
set(LARECOMP_DXC_HOST_ARCHIVE "" CACHE FILEPATH "A local copy of the pinned Windows DXC zip")
option(LARECOMP_DXC_HOST_FETCH "Fetch the pinned DXC release for the host shaders" ON)

function(_larecomp_check_dxc_host_files root pins extracted out)
    set(${out} FALSE PARENT_SCOPE)
    foreach(entry IN LISTS pins)
        string(SUBSTRING "${entry}" 0 64 sha)
        string(SUBSTRING "${entry}" 65 -1 path)
        if(NOT EXISTS "${root}/${path}")
            if(extracted)
                message(WARNING "DXC: the zip holds no ${path}")
            endif()
            return()
        endif()
        file(SHA256 "${root}/${path}" actual)
        if(NOT actual STREQUAL sha)
            if(extracted)
                message(FATAL_ERROR "DXC: ${path} of the zip does not match its SHA-256 (got ${actual}, expected ${sha})")
            endif()
            return()
        endif()
    endforeach()
    set(${out} TRUE PARENT_SCOPE)
endfunction()

set(_dxch_tool "")
if(LARECOMP_DXC_HOST_DIR)
    if(CMAKE_HOST_WIN32 AND EXISTS "${LARECOMP_DXC_HOST_DIR}/bin/x64/dxc.exe")
        set(_dxch_tool "${LARECOMP_DXC_HOST_DIR}/bin/x64/dxc.exe")
    elseif(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux" AND EXISTS "${LARECOMP_DXC_HOST_DIR}/bin/dxc"
           AND EXISTS "${LARECOMP_DXC_HOST_DIR}/lib/libdxcompiler.so")
        set(_dxch_tool "LD_LIBRARY_PATH=${LARECOMP_DXC_HOST_DIR}/lib" "${LARECOMP_DXC_HOST_DIR}/bin/dxc")
    else()
        message(WARNING "DXC: LARECOMP_DXC_HOST_DIR=${LARECOMP_DXC_HOST_DIR} holds no compiler for this host")
    endif()
elseif(CMAKE_HOST_WIN32 AND CMAKE_HOST_SYSTEM_PROCESSOR MATCHES "^(AMD64|x86_64)$"
       AND (LARECOMP_DXC_HOST_FETCH OR LARECOMP_DXC_HOST_ARCHIVE))
    include("${CMAKE_CURRENT_LIST_DIR}/ReadDeps.cmake")
    larecomp_read_kit(dxc_host _dxch_kit)
    string(JSON _dxch_version GET "${_dxch_kit}" version)
    string(JSON _dxch_url GET "${_dxch_kit}" url)
    string(JSON _dxch_zip_sha256 GET "${_dxch_kit}" zip_sha256)
    string(JSON _dxch_zip_size GET "${_dxch_kit}" zip_size)
    larecomp_read_kit_pins("${_dxch_kit}" _dxch_files)

    set(_dxch_root "${CMAKE_BINARY_DIR}/_deps/dxc-host-${_dxch_version}")
    _larecomp_check_dxc_host_files("${_dxch_root}" "${_dxch_files}" FALSE _dxch_have)
    if(NOT _dxch_have)
        set(_dxch_zip "${LARECOMP_DXC_HOST_ARCHIVE}")
        if(NOT _dxch_zip)
            get_filename_component(_dxch_zip_name "${_dxch_url}" NAME)
            set(_dxch_zip "${CMAKE_BINARY_DIR}/_deps/${_dxch_zip_name}")
            if(NOT EXISTS "${_dxch_zip}")
                file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/_deps")
                math(EXPR _dxch_mb "${_dxch_zip_size} / 1000000")
                message(STATUS "larecomp: fetching DXC ${_dxch_version} for the host shaders (${_dxch_mb} MB)")
                file(DOWNLOAD "${_dxch_url}" "${_dxch_zip}.part" STATUS _dxch_status TLS_VERIFY ON INACTIVITY_TIMEOUT 15)
                list(GET _dxch_status 0 _dxch_code)
                if(_dxch_code EQUAL 0)
                    file(RENAME "${_dxch_zip}.part" "${_dxch_zip}")
                else()
                    list(GET _dxch_status 1 _dxch_message)
                    file(REMOVE "${_dxch_zip}.part")
                    message(WARNING "DXC: could not fetch ${_dxch_url} (${_dxch_message})")
                    set(_dxch_zip "")
                endif()
            endif()
        endif()
        if(_dxch_zip AND EXISTS "${_dxch_zip}")
            file(SHA256 "${_dxch_zip}" _dxch_actual)
            if(NOT _dxch_actual STREQUAL _dxch_zip_sha256)
                if(NOT LARECOMP_DXC_HOST_ARCHIVE)
                    file(REMOVE "${_dxch_zip}")
                endif()
                message(FATAL_ERROR "DXC: ${_dxch_zip} does not match its SHA-256 "
                                    "(got ${_dxch_actual}, expected ${_dxch_zip_sha256})")
            endif()
            file(REMOVE_RECURSE "${_dxch_root}")
            file(MAKE_DIRECTORY "${_dxch_root}")
            file(ARCHIVE_EXTRACT INPUT "${_dxch_zip}" DESTINATION "${_dxch_root}"
                 PATTERNS "bin/x64/*" "LICEN[CS]E*")
            _larecomp_check_dxc_host_files("${_dxch_root}" "${_dxch_files}" TRUE _dxch_have)
        endif()
    endif()
    if(_dxch_have)
        set(_dxch_tool "${_dxch_root}/bin/x64/dxc.exe")
    endif()
elseif(LARECOMP_DXC_HOST_FETCH AND CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux" AND CMAKE_SYSTEM_NAME STREQUAL "Linux"
       AND CMAKE_HOST_SYSTEM_PROCESSOR MATCHES "^(AMD64|x86_64)$")
    if(NOT DEFINED LARECOMP_DXC_LINUX_LIB)
        include("${CMAKE_CURRENT_LIST_DIR}/FetchDxcLinux.cmake")
    endif()
    if(EXISTS "${LARECOMP_DXC_LINUX_TOOL}")
        if(LARECOMP_DXC_LINUX_TOOL_SHA256)
            file(SHA256 "${LARECOMP_DXC_LINUX_TOOL}" _dxch_actual)
            if(NOT _dxch_actual STREQUAL LARECOMP_DXC_LINUX_TOOL_SHA256)
                message(FATAL_ERROR "DXC: ${LARECOMP_DXC_LINUX_TOOL} does not match its SHA-256 "
                                    "(got ${_dxch_actual}, expected ${LARECOMP_DXC_LINUX_TOOL_SHA256})")
            endif()
            file(CHMOD "${LARECOMP_DXC_LINUX_TOOL}" FILE_PERMISSIONS
                 OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
        endif()
        get_filename_component(_dxch_lib_dir "${LARECOMP_DXC_LINUX_LIB}" DIRECTORY)
        set(_dxch_tool "LD_LIBRARY_PATH=${_dxch_lib_dir}" "${LARECOMP_DXC_LINUX_TOOL}")
    endif()
endif()

# Keep this selection out of dxc-bin's cache so each configure can pick its
# own compiler and any other users of DIRECTX_DXC_TOOL keep the submodule tool.
if(_dxch_tool)
    set(LARECOMP_DXC_HOST_TOOL "${_dxch_tool}")
    message(STATUS "larecomp: host shaders compile with ${LARECOMP_DXC_HOST_TOOL}")
else()
    set(LARECOMP_DXC_HOST_TOOL "${DIRECTX_DXC_TOOL}")
    if(LARECOMP_DXC_HOST_FETCH OR LARECOMP_DXC_HOST_DIR OR LARECOMP_DXC_HOST_ARCHIVE)
        message(WARNING "larecomp: host shaders use thirdparty/dxc-bin. To use the pinned release offline, set "
                        "LARECOMP_DXC_HOST_DIR or pass LARECOMP_DXC_HOST_ARCHIVE on Windows / "
                        "LARECOMP_DXC_LINUX_ARCHIVE on Linux.")
    endif()
endif()
