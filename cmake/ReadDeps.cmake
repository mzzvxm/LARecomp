include_guard(GLOBAL)

set(_larecomp_deps_file "${CMAKE_CURRENT_LIST_DIR}/deps.json")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_larecomp_deps_file}")
file(READ "${_larecomp_deps_file}" LARECOMP_DEPS)

function(larecomp_read_kit id out)
    string(JSON kit GET "${LARECOMP_DEPS}" kits "${id}")
    set(${out} "${kit}" PARENT_SCOPE)
endfunction()

# Keep the fetchers' existing hash verification and extraction logic.
function(larecomp_read_kit_pins kit out)
    string(JSON count LENGTH "${kit}" files)
    math(EXPR last "${count} - 1")
    set(pins "")
    foreach(i RANGE ${last})
        string(JSON path GET "${kit}" files ${i} path)
        string(JSON sha GET "${kit}" files ${i} sha256)
        list(APPEND pins "${sha} ${path}")
    endforeach()
    set(${out} "${pins}" PARENT_SCOPE)
endfunction()

function(larecomp_kit_group_files kit group out)
    string(JSON count LENGTH "${kit}" files)
    math(EXPR last "${count} - 1")
    set(paths "")
    foreach(i RANGE ${last})
        string(JSON file_group GET "${kit}" files ${i} group)
        if(file_group STREQUAL group)
            string(JSON path GET "${kit}" files ${i} path)
            list(APPEND paths "${path}")
        endif()
    endforeach()
    set(${out} "${paths}" PARENT_SCOPE)
endfunction()
