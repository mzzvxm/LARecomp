};

// The tile at the pixel (x, y) (any integer: the tile repeats) for channel 0, at the pixel moved by (13, 8) for channel 1: uniform on (0, 1).
float BlueNoiseTileAt(int x, int y, uint channel) {
  const uint i = (((uint(y) + channel * 8u) & 31u) << 5u) | ((uint(x) + channel * 13u) & 31u);
  return (float((kBlueNoiseTile[i >> 2u] >> ((i & 3u) * 8u)) & 0xFFu) + 0.5f) * (1.0f / 256.0f);
}
// Both channels of the pixel.
float2 BlueNoiseTile2At(int x, int y) {
  return float2(BlueNoiseTileAt(x, y, 0u), BlueNoiseTileAt(x, y, 1u));
}

#endif  // MCLA_GPU_BLUE_NOISE_HLSLI
