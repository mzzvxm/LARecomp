.patch_backup/

# IDA artefacts. The database lives outside this repo, but keep these patterns
# in case anyone drops one in. .i64 in particular is ~100 MB.
*.i64
*.id0
*.id1
*.id2
*.nam
*.til
*.idb

# Game data — never commit copyrighted assets. You supply your own dump.
*.xex
*.rpf
*.bik
MCLA_Game_Files/

# IDE & Editor files
.vs/
.vscode/*
!.vscode/tasks.json
!.vscode/launch.json
*.user
*.suo
*.userosv
*.sln.docstates

# OS generated files
.DS_Store
Thumbs.db

# src/assets/ holds the generated shader pack, which is far too big to
# version. Nothing in the directory is tracked.
src/assets/
translations/

# Nick registry of a master run from the tree: its signing key and database.
# The key must never be published (anyone with it can mint nick tickets).
identity_master.key
identity_db.txt
identity_db.txt.tmp

# Design notes and RE maps are kept local, out of the repository.
docs/
!src/settings/generated/
